# ======================================================
# Google OAuth 2.0 Configuration
# Fill these values in your local .env file.
# DO NOT commit the real .env with secrets.
# ======================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match exactly the value configured in Google Cloud Console
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback


# ======================================================
# Backend Application Settings (optional but recommended)
# ======================================================

# Server port
PORT=8080

# SQLite database file
DB_PATH=./forum.db

# Cookie settings
SESSION_COOKIE_NAME=session_token
SESSION_DURATION_HOURS=24
