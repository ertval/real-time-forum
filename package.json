{
	"name": "real-time-forum",
	"version": "1.0.0",
	"description": "Real-Time Forum - A Go-based SPA with WebSockets",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"dev": "make run",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write --unsafe .",
		"check": "biome check .",
		"fix": "biome check --write --unsafe .",
		"format": "biome format --write .",
		"policy": "bun run check && bun run test"
	},
	"dependencies": {
		"bun": "^1.3.12"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@playwright/test": "^1.59.1",
		"vitest": "^3.0.7"
	}
}
